{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run ci",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 10 * * *"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs' ':(exclude)*.md' ':(exclude).env.example' ':(exclude)functions' ':(exclude)src/site'"
}
