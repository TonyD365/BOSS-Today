# Postgres connection string. On Vercel the Neon integration sets this for you.
# For local development run `npm run db:local` and use the value below.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/boss_today

# Any long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Optional Google sign-in (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails of super admins. They can always sign in and manage everyone.
SUPER_ADMIN_EMAILS=

# Optional: only let Google accounts on these domains sign in (comma-separated).
# Sign-in is invite-only either way. Super admins are always allowed.
ALLOWED_EMAIL_DOMAINS=

# Optional: let anyone on the school domains create a reader account by signing in.
ALLOW_READER_SIGNUP=false

# Optional: public address of this newsroom (admin) host, e.g. https://bosstoday.vercel.app
SITE_URL=

# The public reader site on Cloudflare Pages, e.g. https://bosstoday.pages.dev.
# When set, reader URLs on this host redirect there. Needed at build time.
PUBLIC_SITE_URL=

# Cloudflare Pages deploy hook URL. Publishing an issue or withdrawing a story calls it.
CLOUDFLARE_DEPLOY_HOOK_URL=

# Optional: lets the newsroom show rebuild progress. Create an API token with
# "Account → Cloudflare Pages → Read", and copy the account ID and project name.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
# Workers KV namespace that holds the site banner (the token above needs KV edit)
CLOUDFLARE_KV_NAMESPACE_ID=

# Shared secret between this host and the Cloudflare Pages build (/api/site-export).
# Any long random string: `openssl rand -hex 32`. Set the same value on Cloudflare.
SITE_EXPORT_TOKEN=

# Image storage, option 1: a GitHub repository served by GitHub Pages (takes priority).
# GITHUB_IMAGES_TOKEN needs "Contents: read and write" on that repository only.
GITHUB_IMAGES_REPO=
GITHUB_IMAGES_TOKEN=
GITHUB_IMAGES_BRANCH=main
# Optional: defaults to https://<owner>.github.io/<repo>
GITHUB_IMAGES_BASE_URL=

# Image storage, option 2: Vercel Blob. On Vercel, creating a Blob store sets this for you.
BLOB_READ_WRITE_TOKEN=
