# Postgres connection string. On Vercel the Neon integration sets this for you.
# For local development run `npm run db:local` and use the value below.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/boss_today

# Any long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Google sign-in for staff (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails of super admins. They can always sign in and manage everyone.
SUPER_ADMIN_EMAILS=

# Optional: Google account domains allowed to sign in (comma-separated).
# Defaults to gapps.yrdsb.ca,yrdsb.ca. Super admins are always allowed.
ALLOWED_EMAIL_DOMAINS=

# Optional: let anyone on the school domains create a reader account by signing in.
ALLOW_READER_SIGNUP=false

# Optional: public address of the site, e.g. https://boss-today.vercel.app
SITE_URL=

# Image storage. On Vercel, creating a Blob store sets this for you.
BLOB_READ_WRITE_TOKEN=
